# .pkgmeta — BigWigsMods/packager configuration
#
# Only takes effect when releasing through the packager (e.g. a GitHub release
# workflow). Bundled libraries are committed in-tree, so nothing is pulled here.

package-as: TomoMod

# We ship libraries embedded, so no separate -nolib zip is produced.
enable-nolib-creation: no

# Files and folders that must NOT ship inside the released addon zip
# (development tooling, repo metadata, CI).
ignore:
  - .git
  - .github
  - .gitattributes
  - .gitignore
  - .luacheckrc
  - .pkgmeta
  - README.md
  - "**/*.bak"
  - "**/.DS_Store"
  # Vendored-library baggage: test suites, examples and generated docs that no
  # lib.xml or embeds.xml ever loads. They exist upstream for the library's own
  # CI and only add weight to what players download.
  - Libs/LibStub/tests
  - Libs/LibCustomGlow-1.0/LibStub/tests
  - Libs/LibDeflate/LibStub/tests
  - Libs/libserialize/libs/LibStub/tests
  - Libs/LibDeflate/examples
  - Libs/LibDeflate/docs
  - Libs/LibDeflate/libdeflate-1.0.2-1.rockspec
  - "Libs/**/README.md"
  - "Libs/**/changelog.md"
  - "Libs/**/CHANGES.txt"
  - "Libs/**/Changelog-*.txt"

# NOTE — Externalising the embedded libraries (oUF, LibDeflate, LibOpenRaid,
# LibSharedMedia-3.0, LibCustomGlow-1.0, LibSerialize, LibDispel, LibStub) is a
# possible follow-up so the packager keeps them up to date automatically. It is
# deliberately left OFF here: this addon ships a *customised* oUF (the embed is
# renamed via "## X-oUF: TomoMod_oUF"), so a vanilla external pull would not
# match. Each library's upstream URL and any local patches must be verified
# before enabling an `externals:` block.

# Sub-addons shipped from this repository: the packager moves them out of
# the main TomoMod folder so they install as sibling addons.
move-folders:
  TomoMod/TomoMod_CDStudio: TomoMod_CDStudio
